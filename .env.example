# ── Hotel Morya Lodging — Environment Variables ─────────────────────────────
# Copy to .env.local and populate with your credentials.

# Public site URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Hotel branding & operational metadata
NEXT_PUBLIC_HOTEL_NAME=Hotel Morya Lodging
NEXT_PUBLIC_HOTEL_SLUG=hotel-morya
NEXT_PUBLIC_ADMIN_EMAIL=hotelmoryaadmapur@gmail.com
NEXT_PUBLIC_SUPER_ADMIN_EMAIL=pravinbagde@gmail.com

# ── Supabase (Database, Auth, Storage & Realtime) ───────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Resend (Transactional emails for booking confirmation & reminders) ────
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL="Hotel Morya Lodging <bookings@hotelmoryaadmapur.in>"
RESEND_FROM_NAME="Hotel Morya Lodging"
RESEND_CONTACT_TO=hotelmoryaadmapur@gmail.com

# ── Cloudinary (Room photos & gallery media) ───────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=morya_uploads

# ── Cloudflare Turnstile (Bot protection on public bookings) ────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Cron secret (cron-job.org / external cron trigger authorization) ────────
CRON_SECRET=your-random-cron-secret-token

# ── Timezone (IST locked) ──────────────────────────────────────────────────
TZ=Asia/Kolkata
